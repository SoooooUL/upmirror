#!/usr/bin/env bash
# ==============================================================================
#  upmirror — Arch Linux 镜像源更新器
#
#  默认后端：rate-mirrors（Rust 实现的 map-aware 镜像测速工具）
#  备用后端：reflector
#
#  主要特性：
#    1. 自动识别所在地区（时区 → IP 定位兜底 → 手动指定）
#    2. 写入前「同步一致性校验」：拿各镜像的 core.db / extra.db 时间戳与官方
#       geomirror 比对，把滞后超过阈值的站点排到列表末尾 —— 只按速度排序会选到
#       「core 旧、extra 新」的镜像，进而导致部分升级（partial upgrade）
#    3. 带时间戳备份 + 失败/中断自动回滚（trap EXIT/INT/TERM）
#    4. 写入前校验：空列表 / 无效列表绝不落盘
#    5. 原子替换：先写临时文件再 mv 覆盖，避免半截文件
#    6. 可选同步更新 archlinuxcn 镜像列表（--cn）
#    7. 可选写入后强制刷库（--sync → pacman -Syy）
#
#  用法：upmirror [选项]（见 upmirror --help）
# ==============================================================================

set -uo pipefail

PROG="${0##*/}"
VERSION="1.2.0"

# ---------- 路径与常量 ----------
TARGET_MIRRORLIST="/etc/pacman.d/mirrorlist"
TARGET_CN_MIRRORLIST="/etc/pacman.d/archlinuxcn-mirrorlist"
PACMAN_CONF="/etc/pacman.conf"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/upmirror"
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_FILE=""              # 安静模式下的测速日志路径（main 里赋值）
KEEP_BACKUPS=10          # 每个目标文件保留的备份份数

# ---------- 保底镜像 ----------
# CERNET（中国教育和科研计算机网）联合镜像站：会自动 302 跳转到离你最近的
# 可用成员镜像（清华/中科大/吉大/南大…），因此放在列表最末尾作为最后兜底。
# 注意 ${repo}/${arch} 由 pacman 展开，这里必须用单引号保持字面量。
readonly FALLBACK_MIRROR='https://mirrors.cernet.edu.cn/archlinux/$repo/os/$arch'
readonly FALLBACK_CN_MIRROR='https://mirrors.cernet.edu.cn/archlinuxcn/$arch'

# ---------- 一致性校验的官方基准 ----------
# 官方 geomirror（Tier 1，geo.mirror.pkgbuild.com 会按地理位置跳到就近的 Tier 1）。
# 用它的 core.db / extra.db 的 Last-Modified 作为「最新快照」基准，逐个比对候选镜像。
readonly BASELINE_MIRROR='https://geo.mirror.pkgbuild.com/$repo/os/$arch'
# 单个探测请求的超时（秒）。超时直接当「未知」处理，不重试 ——
# 慢镜像本来就该被怀疑，不能让它拖垮整个脚本。
readonly PROBE_TIMEOUT=5
# 本机架构：把 mirrorlist 里的 $arch 占位符展开成真实路径
readonly ARCH="$(uname -m)"

# ---------- 默认选项 ----------
OPT_CC=""                # 国家/地区 ISO 代码，空 = 自动检测
OPT_MIRRORS=10           # 写入 mirrorlist 的镜像数量
# 默认 24h，与 rate-mirrors 自身默认值一致。别再收窄：CN 的 https 镜像里
# 同步完成（completion=1）的只有个位数，2h 会把候选砍到 3 个甚至 1 个。
# 真正过期的镜像由下面的「一致性校验」按 core/extra 的实际 Last-Modified 降序，
# 比镜像站自报的整体 delay 精确得多，不需要这里再硬卡。
OPT_MAX_DELAY=86400      # 最大同步延迟（秒），24 小时
# 同步完成度下限（0~1，rate-mirrors 后端的 --completion）。
# 默认不取 1：CN 的镜像长期停在 0.96~0.99（同步进行中），取 1 会让候选池
# 只剩 3 个（实测 2026-10-27，ustc/nju/aliyun），jlu/hit/xjtu/sjtug 全被滤掉。
# completion<1 的实际后果是少数包文件还没到站，pacman 会 404 后自动换下一个
# Server；db 之间的不一致由一致性校验负责挡。想严格按官方建议可以传 --completion 1。
OPT_COMPLETION=0.95
OPT_CHECK=true           # 写入前做同步一致性校验（防部分升级）
OPT_TOLERANCE=3600       # 一致性校验容忍的落后秒数，1 小时
OPT_SYNC=false           # 写入后执行 pacman -Syy 强制刷库
OPT_PROTOCOL="https"     # https / http / both
OPT_CONCURRENCY=16       # 并发测速数
OPT_PER_COUNTRY=5        # 每国测试的镜像数
OPT_NEIGHBORS=false      # 放宽到邻近国家
OPT_CN=false             # 同时更新 archlinuxcn 镜像列表
OPT_BACKEND="auto"       # auto / rate-mirrors / reflector
OPT_DRYRUN=false         # 只预览，不写入
OPT_YES=false            # 跳过交互确认
OPT_QUIET=false          # 安静模式：测速输出进日志文件
OPT_FALLBACK=true        # 末尾追加 CERNET 联合镜像站保底

