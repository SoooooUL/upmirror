# 取本地化字符串
msg() {
    local key="$1"
    if [[ "$UI_LANG" == "zh" ]]; then
        printf '%s' "${M_ZH[$key]:-?$key?}"
    else
        printf '%s' "${M_EN[$key]:-?$key?}"
    fi
}

# ---------- 输出样式 ----------
readonly C_RED=$'\033[1;31m' C_GREEN=$'\033[1;32m' C_YELLOW=$'\033[1;33m'
readonly C_BLUE=$'\033[1;34m' C_CYAN=$'\033[1;36m' C_DIM=$'\033[2m' C_NC=$'\033[0m'

info()  { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_NC" "$*"; }
ok()    { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_NC" "$*"; }
warn()  { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_NC" "$*"; }
err()   { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_NC" "$*" >&2; }
die()   { err "$*"; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# ---------- 回滚/清理机制 ----------
declare -a RB_TARGETS=() RB_BACKUPS=() RB_STATE=()   # 状态: yes(原本存在) / no(原本不存在) / unknown(备份失败)
declare -a TMP_FILES=()
SCRIPT_OK=false

# 创建临时文件并登记（退出时统一删除）
# 注意：不能用命令替换（`f=$(new_tmp x)`）——那样函数跑在子 shell 里，
# TMP_FILES 的修改会丢失，导致临时文件永远不被清理。改用 nameref 写回调用者变量。
new_tmp() {   # $1=调用者变量名  $2=前缀
    local -n _ref="$1"
    _ref="$(mktemp "$CACHE_DIR/$2.XXXXXX")" || die "mktemp failed in $CACHE_DIR"
    TMP_FILES+=("$_ref")
}

clean_tmp() {
    local f
    for f in "${TMP_FILES[@]:-}"; do
        [[ -n "$f" ]] && rm -f -- "$f"
    done
}

register_target() {
    local target="$1" bak
    if [[ -f "$target" ]]; then
        bak="$CACHE_DIR/$(basename "$target").$STAMP.bak"
        if sudo cp -p -- "$target" "$bak" 2>/dev/null; then
            sudo chown "$(id -u):$(id -g)" "$bak" 2>/dev/null || true
            RB_TARGETS+=("$target"); RB_BACKUPS+=("$bak"); RB_STATE+=("yes")
            ok "$(msg backup_saved) ${C_DIM}$bak${C_NC}"
            ln -sfn "$(basename "$bak")" "$CACHE_DIR/$(basename "$target").latest.bak" 2>/dev/null || true
            prune_backups "$(basename "$target")"
        else
            RB_TARGETS+=("$target"); RB_BACKUPS+=(""); RB_STATE+=("unknown")
            warn "backup failed: $target"
        fi
    else
        RB_TARGETS+=("$target"); RB_BACKUPS+=(""); RB_STATE+=("no")
    fi
}

prune_backups() {
    local base="$1"
    # 备份均为用户属主，可直接删除；保留最近 KEEP_BACKUPS 份
    ls -1t "$CACHE_DIR/$base".*.bak 2>/dev/null | tail -n "+$((KEEP_BACKUPS + 1))" | xargs -r rm -f
}

cleanup() {
    local code=$? i
    trap - EXIT INT TERM HUP
    if [[ "$SCRIPT_OK" != true && ${#RB_TARGETS[@]} -gt 0 ]]; then
        printf '\n'
        warn "$(msg rollback)"
        for i in "${!RB_TARGETS[@]}"; do
            case "${RB_STATE[$i]}" in
                yes)
                    if sudo cp -p -- "${RB_BACKUPS[$i]}" "${RB_TARGETS[$i]}"; then
                        ok "$(msg restored) ${RB_TARGETS[$i]}"
                    else
                        err "$(msg rollback_fail) ${RB_TARGETS[$i]}"
                    fi
                    ;;
                no)
                    sudo rm -f -- "${RB_TARGETS[$i]}" && ok "$(msg removed_new) ${RB_TARGETS[$i]}"
                    ;;
                *) : ;;   # 备份失败，保持原样不动
            esac
        done
    fi
    clean_tmp
    exit "$code"
}

