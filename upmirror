# ---------- 参数解析 ----------
need_int() {   # $1=选项名 $2=值
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "$1 $(msg err_bad_int)"
}

need_ratio() {   # $1=选项名 $2=值（0~1 的小数，rate-mirrors 的 --completion）
    [[ "${2:-}" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || die "$1 $(msg err_bad_ratio)"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)       usage; exit 0 ;;
            -V|--version)    printf 'upmirror %s\n' "$VERSION"; exit 0 ;;
            -c|--country)    shift; OPT_CC="${1:-}"; [[ -n "$OPT_CC" ]] || die "--country $(msg err_need_arg)" ;;
            -n|--mirrors)    shift; need_int "--mirrors" "${1:-}"; OPT_MIRRORS="$1" ;;
            --max-delay)     shift; need_int "--max-delay" "${1:-}"; OPT_MAX_DELAY="$1" ;;
            --completion)    shift; need_ratio "--completion" "${1:-}"; OPT_COMPLETION="$1" ;;
            --protocol)      shift; OPT_PROTOCOL="${1:-}" ;;
            --concurrency)   shift; need_int "--concurrency" "${1:-}"; OPT_CONCURRENCY="$1" ;;
            --per-country)   shift; need_int "--per-country" "${1:-}"; OPT_PER_COUNTRY="$1" ;;
            --neighbors)     OPT_NEIGHBORS=true ;;
            --cn)            OPT_CN=true ;;
            --backend)       shift; OPT_BACKEND="${1:-}" ;;
            --dry-run)       OPT_DRYRUN=true; SCRIPT_OK=true ;;   # 不写文件，无需回滚
            --check)         OPT_CHECK=true ;;
            --no-check)      OPT_CHECK=false ;;
            --tolerance)     shift; need_int "--tolerance" "${1:-}"; OPT_TOLERANCE="$1" ;;
            --sync)          OPT_SYNC=true ;;
            -y|--yes)        OPT_YES=true ;;
            -q|--quiet)      OPT_QUIET=true ;;
            --no-fallback)   OPT_FALLBACK=false ;;
            --)              shift; break ;;
            *)               die "$(msg err_unknown_opt): $1" ;;
        esac
        shift
    done

    case "$OPT_PROTOCOL" in
        https|http|both) ;;
        *) die "$(msg err_bad_proto)" ;;
    esac
    case "$OPT_BACKEND" in
        auto|rate-mirrors|reflector) ;;
        *) die "$(msg err_bad_backend)" ;;
    esac
    (( OPT_MIRRORS > 0 )) || die "--mirrors $(msg err_bad_int)"
}

# ---------- 地区识别 ----------
detect_cc_by_tz() {
    local tz=""
    if have timedatectl; then
        tz="$(timedatectl show -p Timezone --value 2>/dev/null)"
    fi
    if [[ -z "$tz" && -e /etc/localtime ]]; then
        tz="$(readlink -f /etc/localtime 2>/dev/null | sed 's#.*/zoneinfo/##')"
    fi
    case "$tz" in
        Asia/Shanghai|Asia/Chongqing|Asia/Urumqi|Asia/Harbin|Asia/Beijing|PRC) echo CN ;;
        Asia/Hong_Kong)        echo HK ;;
        Asia/Taipei)           echo TW ;;
        Asia/Tokyo|Asia/Osaka) echo JP ;;
        Asia/Seoul)            echo KR ;;
        Asia/Singapore)        echo SG ;;
        Asia/Kolkata|Asia/Calcutta) echo IN ;;
        Asia/Bangkok)          echo TH ;;
        Asia/Ho_Chi_Minh|Asia/Saigon) echo VN ;;
        Asia/Kuala_Lumpur)     echo MY ;;
        Asia/Jakarta)          echo ID ;;
        Asia/Manila)           echo PH ;;
        Asia/Dubai)            echo AE ;;
        Europe/London)         echo GB ;;
        Europe/Berlin|Europe/Frankfurt) echo DE ;;
        Europe/Paris)          echo FR ;;
        Europe/Amsterdam)      echo NL ;;
        Europe/Moscow)         echo RU ;;
        Australia/Sydney|Australia/Melbourne|Australia/Brisbane|Australia/Perth) echo AU ;;
        America/New_York|America/Chicago|America/Denver|America/Los_Angeles|America/Phoenix) echo US ;;
        America/Toronto|America/Vancouver) echo CA ;;
        America/Sao_Paulo)     echo BR ;;
        *) echo "" ;;
    esac
}

detect_cc_by_ip() {
    local raw="" src
    have curl || return 0
    # 多源兜底 + 强制 IPv4：单个服务很容易在特定地区不可达，
    # 且 IPv6 不通时每个源都要白等满超时
    for src in 'https://ipapi.co/country' \
               'https://ipinfo.io/country' \
               'https://api.country.is/'; do
        raw="$(curl -4 -fsS --max-time 3 -- "$src" 2>/dev/null | tr -d '[:space:]')"
        # JSON 源（api.country.is）取 "country":"XX"
        if [[ "$raw" =~ \"country\":\"([A-Za-z]{2})\" ]]; then
            printf '%s' "${BASH_REMATCH[1]^^}"; return 0
        fi
        # 纯文本源直接就是两位代码
        [[ "$raw" =~ ^[A-Za-z]{2}$ ]] && { printf '%s' "${raw^^}"; return 0; }
    done
    return 0
}

# 名称/代码 → 2 位代码（全名需 reflector 的国家表）
normalize_cc() {
    local v="$1"
    if [[ "$v" =~ ^[A-Za-z]{2}$ ]]; then
        printf '%s' "${v^^}"; return 0
    fi
    if have reflector; then
        local code
        code="$(reflector --list-countries 2>/dev/null | awk -v want="${v,,}" '
            { if (match($0, /[ \t][A-Z][A-Z][ \t]+[0-9]+[ \t]*$/)) {
                  name = substr($0, 1, RSTART-1); gsub(/[ \t]+$/, "", name)
                  if (tolower(name) == want) { print substr($0, RSTART+1, 2); exit } } }')"
        [[ -n "$code" ]] && { printf '%s' "$code"; return 0; }
    fi
    return 1
}

# 代码 → reflector 用的国家全名
cc_to_name() {
    have reflector || return 1
    reflector --list-countries 2>/dev/null | awk -v want="${1^^}" '
        { if (match($0, /[ \t][A-Z][A-Z][ \t]+[0-9]+[ \t]*$/)) {
              if (substr($0, RSTART+1, 2) == want) {
                  name = substr($0, 1, RSTART-1); gsub(/[ \t]+$/, "", name); print name; exit } } }'
}

# 逗号分隔的代码列表 → reflector 用的国家全名列表（转不出来的保留原代码）
cc_names() {   # $1=候选代码列表（可为空） $2=基础 cc
    local list="${1:-$2}" out="" code name
    local -a codes=()
    [[ -n "$list" ]] || return 1
    IFS=',' read -ra codes <<< "$list"
    for code in "${codes[@]}"; do
        [[ -n "$code" ]] || continue
        name="$(cc_to_name "$code" 2>/dev/null)"
        [[ -n "$name" ]] || name="$code"   # 新版本 reflector 也接受代码
        out="${out:+$out,}$name"
    done
    printf '%s' "$out"
}

# 邻近国家/地区（只用于 --neighbors 放宽范围）
neighbor_codes() {
    case "$1" in
        CN) echo "CN,HK,TW,JP,KR,SG" ;;
        HK) echo "HK,CN,TW,JP,SG" ;;
        TW) echo "TW,JP,HK,CN,SG" ;;
        JP) echo "JP,KR,TW,HK,CN" ;;
        KR) echo "KR,JP,CN,TW" ;;
        SG) echo "SG,MY,ID,TH,VN,CN" ;;
        MY) echo "MY,SG,ID,TH,VN" ;;
        US) echo "US,CA" ;;
        CA) echo "CA,US" ;;
        GB|DE|FR|NL|BE) echo "DE,FR,NL,GB,BE" ;;
        AU) echo "AU,NZ,SG" ;;
        RU) echo "RU,DE,NL,FI" ;;
        IN) echo "IN,SG,AE" ;;
        BR) echo "BR,US" ;;
        *)  echo "$1" ;;
    esac
}

# ---------- 后端 ----------
pick_backend() {
    case "$OPT_BACKEND" in
        rate-mirrors)
            have rate-mirrors || die "$(msg no_tool)"
            echo rate-mirrors ;;
        reflector)
            have reflector || die "$(msg no_tool)"
            echo reflector ;;
        auto)
            if have rate-mirrors; then echo rate-mirrors
            elif have reflector; then echo reflector
            else die "$(msg no_tool)"
            fi ;;
    esac
}

# 实际执行后端命令；$1=backend $2=out $3..=命令
# 单独抽出成函数，便于安静模式下统一把输出重定向到日志
run_backend() {
    local backend="$1" out="$2"; shift 2
    if [[ "$backend" == "reflector" ]]; then
        # reflector 自己会输出 "# When:" 头部，compose_list 还会再写一条给 sysup，
        # 这里先滤掉，避免文件里出现两个 "# When:"（按首行解析的工具会困惑）
        "$@" 2>/dev/null | grep -E '^(#|Server[[:space:]]*=)' | grep -vE '^#[[:space:]]*When:' > "$out"
        return "${PIPESTATUS[0]}"
    fi
    "$@"
}

# 生成镜像列表到 $1；成功返回 0
generate_list() {
    local out="$1" backend="$2" cc="$3" filter="$4"
    local -a cmd=()

    case "$backend" in
        rate-mirrors)
            cmd=(rate-mirrors
                 --concurrency="$OPT_CONCURRENCY"
                 --country-test-mirrors-per-country="$OPT_PER_COUNTRY"
                 --max-mirrors-to-output="$OPT_MIRRORS"
                 --disable-comments-in-file
                 --disable-untested-fallback
                 --save="$out")
            # 入口国家不能硬编码：全球模式（时区/IP 都没识别出来）下写死 US，
            # 中文用户会被带到美国镜像。留空则用后端自己的默认值，main 里会提示。
            [[ -n "$cc" ]] && cmd+=(--entry-country="$cc")
            case "$OPT_PROTOCOL" in
                https) cmd+=(--protocol=https) ;;
                http)  cmd+=(--protocol=http) ;;
                both)  cmd+=(--protocol=http --protocol=https) ;;
            esac
            [[ -n "$filter" ]] && cmd+=(--include-countries="$filter")
            # --completion：默认 0.95，见 OPT_COMPLETION 处的说明
            # --max-delay：只要最近同步过的，语义与 OPT_MAX_DELAY 一致
            cmd+=(arch --completion="$OPT_COMPLETION" --max-delay="$OPT_MAX_DELAY")
            ;;
        reflector)
            # reflector 的 --country 支持逗号多国，所以 --neighbors 在这里也能生效
            local countries
            countries="$(cc_names "$filter" "$cc")"
            [[ -n "$countries" ]] || return 1
            local proto="https"
            case "$OPT_PROTOCOL" in
                both) proto="http,https" ;;
                *)    proto="$OPT_PROTOCOL" ;;
            esac
            # --delay 接受小数（小时），直接对应 OPT_MAX_DELAY；
            # 旧写法 --age 取整到小时，传 --max-delay 1800 会被放大成 1 小时
            cmd=(reflector --sort rate --verbose --download-timeout 5
                 --protocol "$proto"
                 --delay "$(awk -v s="$OPT_MAX_DELAY" 'BEGIN{printf "%.4f", s / 3600}')"
                 --fastest "$OPT_MIRRORS"
                 --country "$countries")
            ;;
        *) return 1 ;;
    esac

    info "$(msg cmd_preview): ${C_DIM}${cmd[*]}${C_NC}"
    if [[ "$OPT_QUIET" == true ]]; then
        info "$(msg quiet_log): ${C_DIM}${LOG_FILE}${C_NC}"
        run_backend "$backend" "$out" "${cmd[@]}" >>"$LOG_FILE" 2>&1
    else
        run_backend "$backend" "$out" "${cmd[@]}"
    fi
}

# 统计有效 Server 行数（要求带协议前缀，拒绝写进去的垃圾行）
server_count() {
    grep -cE '^[[:space:]]*Server[[:space:]]*=[[:space:]]*(https?|rsync|ftp|file)://' "$1" 2>/dev/null || true
}

# 校验：非空、至少一行合法 Server =
validate_list() {
    local f="$1" n
    [[ -s "$f" ]] || return 1
    n="$(server_count "$f")"
    [[ "${n:-0}" -gt 0 ]] || return 1
    return 0
}

# ---------- 同步一致性校验 ----------
# Arch Wiki 的 Mirrors 页写得很清楚：只按速度排序是不够的，最快的镜像可能已经过期。
# 更阴的是「只同步了一半」的镜像：core 旧、extra 新，于是 pacman 在同一事务里
# 拿到了两套时间点的数据库 —— perl 本体还留在旧版，而依赖它的 Perl 模块
# 已经按新版重编译，装完就报 Can't locate ... in @INC（部分升级）。
#
# rate-mirrors / reflector 用的都是镜像站自己上报的 last_sync / delay，
# 只能说明「最近同步过」，盖不住单个仓库的滞后。这里直接拿官方 geomirror
# 的 core.db / extra.db 时间戳做基准，逐个比对候选镜像的同类文件。

# 秒数 → 人类可读（负数视为 0：镜像比基准新就是不落后）
fmt_dur() {
    local s="$1"
    (( s < 0 )) && s=0
    if   (( s >= 86400 )); then printf '%dd%dh' $(( s / 86400 )) $(( s % 86400 / 3600 ))
    elif (( s >= 3600 ));  then printf '%dh%dm' $(( s / 3600 ))  $(( s % 3600 / 60 ))
    elif (( s >= 60 ));    then printf '%dm%ds' $(( s / 60 ))    $(( s % 60 ))
    else printf '%ds' "$s"
    fi
}

# 读取 URL 的 Last-Modified，输出 epoch 秒；拿不到则输出空串
# 用 -L 跟随 302（cernet 联合镜像站这类入口会跳转到成员站）；
# 跟随重定向后会有多组响应头，取最后一组。
# 关键细节：一次请求同时把状态码拿回来，才能区分「超时/连不上」（code=000，
# 再发一次 GET 也是白等）与「站点不支持 HEAD」（405/501，才值得重试）。
# 不挂代理、网络卡的时候，后者是少数，前者占绝大多数。
fetch_last_modified() {
    local url="$1" out="" code="" hdr=""
    have curl || return 0
    out="$(curl -4 -sS -I -L --max-redirs 5 --max-time "$PROBE_TIMEOUT" \
           -o /dev/null -D - -w '\nHTTPCODE:%{http_code}' -- "$url" 2>/dev/null)"
    code="$(printf '%s' "$out" | sed -n 's/^HTTPCODE://p' | tail -n1)"
    hdr="$(printf '%s' "$out" | tr -d '\r' \
           | sed -n 's/^[Ll]ast-[Mm]odified:[[:space:]]*//p' | tail -n1)"
    if [[ -z "$hdr" && ( "$code" == "405" || "$code" == "501" ) ]]; then
        # 该站明确拒绝 HEAD，退回「只取 1 字节的 GET」拿响应头
        out="$(curl -4 -sS -r 0-0 -L --max-redirs 5 --max-time "$PROBE_TIMEOUT" \
               -o /dev/null -D - -- "$url" 2>/dev/null)"
        hdr="$(printf '%s' "$out" | tr -d '\r' \
               | sed -n 's/^[Ll]ast-[Mm]odified:[[:space:]]*//p' | tail -n1)"
    fi
    [[ -n "$hdr" ]] || return 0
    date -u -d "$hdr" +%s 2>/dev/null
}

# 某个镜像某个仓库的 db 文件的 Last-Modified → epoch
mirror_db_epoch() {   # $1=镜像 URL  $2=core|extra
    local url="${1//\$repo/$2}"
    url="${url//\$arch/$ARCH}"
    [[ "$url" == */ ]] || url="$url/"
    fetch_last_modified "${url}$2.db"
}

# 并行探测所有 URL。结果写到目录里（每个 URL 一个文件），
# 避免后台子 shell 里的变量赋值丢失。
# watchdog：单个 URL 最坏 PROBE_TIMEOUT秒×2（core + extra），超过上限还没回来的
# 直接 kill（该镜像记为「未知」）—— 网络卡不影响脚本继续往下跑。
probe_all() {   # $1=输出目录 $2..=URL
    local dir="$1"; shift
    local i=0 url pid alive waited limit
    local -a pids=()
    for url in "$@"; do
        i=$((i + 1))
        ( printf '%s\t%s\t%s\n' "$url" \
              "$(mirror_db_epoch "$url" core)" \
              "$(mirror_db_epoch "$url" extra)" > "$dir/$i" ) &
        pids+=("$!")
    done
    limit=$(( PROBE_TIMEOUT * 2 + 3 )); waited=0
    while (( waited < limit )); do
        alive=0
        for pid in "${pids[@]}"; do
            kill -0 "$pid" 2>/dev/null && alive=$((alive + 1))
        done
        (( alive == 0 )) && break
        sleep 1
        waited=$((waited + 1))
    done
    for pid in "${pids[@]}"; do
        kill -0 "$pid" 2>/dev/null && kill "$pid" 2>/dev/null
    done
    wait 2>/dev/null || true
}

# 排序方法（不是过滤）：滞后超过 OPT_TOLERANCE 的排到最后；拿不到时间戳的
# 排在中间；其余保持后端测速给出的相对顺序。三档都保留，不会丢镜像。
check_mirror_consistency() {   # $1=输入列表 $2=输出列表
    local in="$1" out="$2"
    local -a urls=()
    # 只取合法行（带协议前缀），与 server_count 保持同一套判定：
    # 否则 "Server = garbage" 这种垃圾行也会被当成镜像去探测，
    # 探测必然失败 → 归入「未知」档 → 又被写回最终文件。
    mapfile -t urls < <(grep -E '^[[:space:]]*Server[[:space:]]*=[[:space:]]*(https?|rsync|ftp|file)://' "$in" \
                        | sed -E 's/^[[:space:]]*Server[[:space:]]*=[[:space:]]*//')
    if (( ${#urls[@]} == 0 )); then cp -- "$in" "$out"; return 0; fi

    printf '\n%s%s%s\n' "$C_CYAN" "$(msg check_title)" "$C_NC"

    local dir; dir="$(mktemp -d "$CACHE_DIR/probe.XXXXXX")" || { cp -- "$in" "$out"; return 0; }
    PROBE_DIRS+=("$dir")
    # 基准和候选镜像一起并行探测：基准不再单独串行占一份超时
    probe_all "$dir" "$BASELINE_MIRROR" "${urls[@]}"

    local bc="" be=""
    [[ -f "$dir/1" ]] && IFS=$'\t' read -r _ bc be < "$dir/1"
    if [[ -z "$bc" || -z "$be" ]]; then
        warn "$(msg check_baseline)"
        rm -rf -- "$dir"
        cp -- "$in" "$out"
        return 0
    fi

    local i url c e lc le name mark unknown=0
    # 三档排序，各档内部保持后端测速给出的相对顺序：
    #   好（与官方同步） → 未知（探不到时间戳） → 差（滞后超过容忍度）
    # 一致性差的只往后排、不剔除：它们是有效的备用镜像，前面的都挂了仍能
    # 顶上，又不会因「core 旧、extra 新」而在正常升级时被优先选中。
    local -a ok_urls=() unknown_urls=() stale_urls=()
    printf '%s  %-40s %-12s %-12s %s%s\n' "$C_DIM" "mirror" "core" "extra" "" "$C_NC"
    for i in "${!urls[@]}"; do
        url="${urls[$i]}"
        c=""; e=""
        [[ -f "$dir/$((i + 2))" ]] && IFS=$'\t' read -r _ c e < "$dir/$((i + 2))"
        # 只显示 host，完整路径太长
        name="${url#*://}"; name="${name%%/*}"
        if [[ -z "$c" || -z "$e" ]]; then
            mark="$(msg check_unknown)"
            unknown=$((unknown + 1))
            unknown_urls+=("$url")
            printf '  %-40s %-12s %-12s %s%s%s\n' "$name" '-' '-' "$C_YELLOW" "$mark" "$C_NC"
            continue
        fi
        lc=$(( bc - c )); le=$(( be - e ))
        if (( lc > OPT_TOLERANCE || le > OPT_TOLERANCE )); then
            mark="$(msg check_stale)"
            stale_urls+=("$url")
            printf '  %-40s %-12s %-12s %s%s%s\n' "$name" \
                   "$(fmt_dur "$lc")" "$(fmt_dur "$le")" "$C_RED" "$mark" "$C_NC"
        else
            mark="$(msg check_ok)"
            ok_urls+=("$url")
            printf '  %-40s %-12s %-12s %s%s%s\n' "$name" \
                   "$(fmt_dur "$lc")" "$(fmt_dur "$le")" "$C_GREEN" "$mark" "$C_NC"
        fi
    done
    rm -rf -- "$dir"

    # 大面积探测失败通常是本地网络问题（比如没挂代理），不是镜像坏了，
    # 这时只提示，不要因此改变列表
    if (( unknown > 0 && unknown * 2 >= ${#urls[@]} )); then
        warn "$(msg check_network)"
    fi

    # 按档位重新拼接（全部滞后的情况自然退化为「原顺序」）
    printf 'Server = %s\n' "${ok_urls[@]}" "${unknown_urls[@]}" "${stale_urls[@]}" > "$out"
    if (( ${#stale_urls[@]} > 0 )); then
        warn "$(msg check_demoted): ${#stale_urls[@]}"
    elif (( unknown == 0 )); then
        # 有未知镜像时不说「全部与官方同步」，那是不准确的
        ok "$(msg check_all_ok)"
    fi
    return 0
}

# 生成带头部注释的最终文件；$6 为保底镜像地址（可为空），$7 覆盖 max-delay 标签
compose_list() {
    local src="$1" dst="$2" backend="$3" cc="$4" filter="$5" fallback="${6:-}" max_delay_tag="${7:-${OPT_MAX_DELAY}s}"
    # 单国模式下 filter 与 cc 相同，再写 "(candidates: CN)" 只是噪音；
    # 只有 --neighbors 真正带来额外候选时才值得列出。
    local region="${cc:-auto/global}"
    [[ -n "$filter" && "$filter" != "$cc" ]] && region+=" (candidates: $filter)"
    {
        printf '##\n'
        printf '## Arch Linux repository mirrorlist\n'
        printf '##\n'
        printf '## Generated by upmirror %s on %s\n' "$VERSION" "$(date '+%Y-%m-%d %H:%M:%S %Z')"
        printf '## Backend: %s | protocol=%s | max-delay=%s | mirrors=%s\n' \
               "$backend" "$OPT_PROTOCOL" "$max_delay_tag" "$OPT_MIRRORS"
        printf '## Region: %s\n' "$region"
        printf '##\n\n'
        # reflector 兼容行：sysup 等工具靠它判断镜像源时效（格式必须是
        # "YYYY-MM-DD HH:MM:SS UTC"，且必须用单个 # 开头）
        printf '# When:       %s UTC\n\n' "$(date -u '+%Y-%m-%d %H:%M:%S')"
        cat "$src"
        if [[ -n "$fallback" && "$OPT_FALLBACK" == true ]]; then
            printf '\n## %s\n' "$(msg fallback_note)"
            printf 'Server = %s\n' "$fallback"
        fi
    } > "$dst"
}

# 原子替换
install_atomic() {
    local src="$1" dst="$2" tmp
    # 注意: 不能写成 local src="$1" dst="$2" tmp="$dst.upmirror.new"
    # 同一行内 $dst 尚未生效，set -u 会直接报“未绑定的变量”
    tmp="$dst.upmirror.new"
    ATOMIC_TMPS+=("$tmp")
    if sudo cp -- "$src" "$tmp" \
        && sudo chmod 0644 "$tmp" \
        && sudo chown root:root "$tmp" \
        && sudo mv -f -- "$tmp" "$dst"; then
        return 0
    fi
    # 中途失败：立刻清掉半成品，不留 sudo 属主的残留文件
    sudo rm -f -- "$tmp" 2>/dev/null
    return 1
}

# 可选：更新 archlinuxcn 镜像列表（该仓库只有 rate-mirrors 支持）
update_cn_mirrorlist() {
    local tmp_cn final_cn
    new_tmp tmp_cn cn
    # 父级参数与主列表对齐：并发、输出上限、协议过滤，以及
    # --disable-untested-fallback（防止全部测速失败时写入未测速镜像）。
    local -a cmd=(rate-mirrors
                  --concurrency="$OPT_CONCURRENCY"
                  --max-mirrors-to-output="$OPT_MIRRORS"
                  --disable-comments-in-file
                  --disable-untested-fallback
                  --save="$tmp_cn")
    case "$OPT_PROTOCOL" in
        https) cmd+=(--protocol=https) ;;
        http)  cmd+=(--protocol=http) ;;
        both)  cmd+=(--protocol=http --protocol=https) ;;
    esac
    # archlinuxcn 的镜像不按地区筛，也不支持 --completion/--max-delay
    # （该子命令只接受 --fetch-mirrors-timeout/--mirror-list-file/--path-to-test/
    # --arch/--comment-prefix，加错会直接 Usage 报错），所以头部 max-delay 标 n/a。
    if "${cmd[@]}" archlinuxcn 2>/dev/null \
       && validate_list "$tmp_cn"; then
        register_target "$TARGET_CN_MIRRORLIST"
        new_tmp final_cn cnfinal
        compose_list "$tmp_cn" "$final_cn" "rate-mirrors" "archlinuxcn" "" "$FALLBACK_CN_MIRROR" "n/a"
        if install_atomic "$final_cn" "$TARGET_CN_MIRRORLIST"; then
            ok "$(msg cn_updated) ${C_GREEN}$TARGET_CN_MIRRORLIST${C_NC}"
            if ! awk '/^\[archlinuxcn\]/{f=1;next} /^\[/{f=0} f' "$PACMAN_CONF" 2>/dev/null \
                 | grep -qE '^[[:space:]]*Include[[:space:]]*='; then
                printf '\n'
                warn "$(msg cn_hint1)"
                printf '        %s\n' "$(msg cn_hint2)"
            fi
        fi
    else
        warn "$(msg cn_failed)"
    fi
}

# ---------- 主流程 ----------
main() {
    parse_args "$@"

    printf '\n%s=== %s ===%s\n' "$C_CYAN" "$(msg title)" "$C_NC"

    # 1. 后端
    local backend; backend="$(pick_backend)"

    # 2. 确定地区
    local cc="" detect_source=""
    if [[ -n "$OPT_CC" ]]; then
        cc="$(normalize_cc "$OPT_CC")" || die "$(msg err_bad_cc): $OPT_CC"
    else
        info "$(msg detecting)"
        cc="$(detect_cc_by_tz)"
        if [[ -z "$cc" ]]; then
            cc="$(detect_cc_by_ip)"
            [[ -n "$cc" ]] && detect_source="$cc"
        fi
        if [[ -z "$cc" ]]; then
            warn "$(msg global_mode)"
        elif [[ "$OPT_YES" != true && -t 0 ]]; then
            printf '%s%s%s: %s%s%s. %s' \
                   "$C_YELLOW" "$(msg detected)" "$C_NC" \
                   "$C_CYAN" "$cc" "$C_NC" "$(msg confirm_region)"
            local ans; read -r ans
            if [[ ! "${ans:-Y}" =~ ^[Yy] ]]; then
                printf '%s' "$(msg ask_cc)"
                read -r ans
                [[ -n "$ans" ]] || die "$(msg cancelled)"
                cc="$(normalize_cc "$ans")" || die "$(msg err_bad_cc): $ans"
            fi
        fi
    fi

    # 3. 候选范围
    local filter=""
    if [[ -n "$cc" ]]; then
        info "$(msg using_region): ${C_GREEN}${cc}${C_NC}"
        if [[ "$OPT_NEIGHBORS" == true ]]; then
            filter="$(neighbor_codes "$cc")"
        else
            filter="$cc"
        fi
    fi

    # 4. 初始化
    mkdir -p "$CACHE_DIR" 2>/dev/null || die "cannot create $CACHE_DIR"
    LOG_FILE="$CACHE_DIR/last-run.log"
    # 单一 trap：负责临时文件清理 + 失败的镜像列表回滚
    trap cleanup EXIT INT TERM HUP
    local tmp_list checked
    new_tmp tmp_list list

    # 5. 测速生成
    info "$(msg running)"
    if ! generate_list "$tmp_list" "$backend" "$cc" "$filter" || ! validate_list "$tmp_list"; then
        [[ -s "$tmp_list" ]] || warn "$(msg empty_result)"
        die "$(msg invalid_result)"
    fi

    # 5.5 同步一致性校验：把「core 旧、extra 新」这类会引发部分升级的镜像排到末尾
    new_tmp checked checked
    if [[ "$OPT_CHECK" == true ]]; then
        check_mirror_consistency "$tmp_list" "$checked"
    else
        cp -- "$tmp_list" "$checked"
    fi

    local n_servers
    n_servers="$(server_count "$checked")"
    if (( n_servers < OPT_MIRRORS )); then
        info "$(msg few_mirrors): ${n_servers} < ${OPT_MIRRORS}"
        # 纯单国模式下候选池可能天然小于 --mirrors，给出可操作的下一步
        if [[ "$OPT_NEIGHBORS" != true && -n "$cc" ]]; then
            info "  $(msg few_mirrors_hint)"
        fi
    fi

    # 6. 组装最终内容（头部注释 + 镜像 + 保底）
    local final; new_tmp final final
    compose_list "$checked" "$final" "$backend" "$cc" "$filter" "$FALLBACK_MIRROR"

    printf '\n%s%s%s\n' "$C_CYAN" "$(msg result_title)" "$C_NC"
    grep -E '^[[:space:]]*Server[[:space:]]*=' "$final" | nl -ba -w2 -s'. ' || true

    # 7. 预览模式直接结束
    if [[ "$OPT_DRYRUN" == true ]]; then
        printf '\n'
        ok "$(msg dry_run)"
        printf '%s\n' "$(msg suggest)"
        return 0
    fi

    # 8. 备份 + 注册回滚
    info "$(msg need_sudo)"
    sudo -v || die "$(msg need_sudo)"
    register_target "$TARGET_MIRRORLIST"

    # 9. 原子写入
    if ! install_atomic "$final" "$TARGET_MIRRORLIST"; then
        die "$(msg err_no_write): $TARGET_MIRRORLIST"
    fi
    ok "$(msg written) ${C_GREEN}$TARGET_MIRRORLIST${C_NC}"

    # 10. 可选：archlinuxcn（只有 rate-mirrors 支持该仓库）
    if [[ "$OPT_CN" == true ]]; then
        if have rate-mirrors; then
            update_cn_mirrorlist
        else
            warn "$(msg cn_need_tool)"
        fi
    fi

    # 11. 可选：强制刷新数据库（只刷库，不升级）
    if [[ "$OPT_SYNC" == true ]]; then
        printf '\n'
        info "$(msg sync_running)"
        if sudo pacman -Syy; then
            ok "$(msg sync_ok)"
        else
            warn "$(msg sync_fail)"
        fi
        printf '%s\n' "$(msg sync_hint)"
    fi

    printf '\n'
    ok "$(msg final_backup): ${C_DIM}$CACHE_DIR${C_NC}"
    printf '%s\n' "$(msg suggest)"

    SCRIPT_OK=true
    return 0
}

# 被 source 时（例如测试脚本）不自动执行，只提供函数
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
