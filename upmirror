#!/usr/bin/env bash
# ==============================================================================
#  upmirror — Arch Linux 镜像源更新器
#
#  默认后端：rate-mirrors（Rust 实现的 map-aware 镜像测速工具）
#  备用后端：reflector
#
#  主要特性：
#    1. 自动识别所在地区（时区 → IP 定位兜底 → 手动指定）
#    2. 带时间戳备份 + 失败/中断自动回滚（trap EXIT/INT/TERM）
#    3. 写入前校验：空列表 / 无效列表绝不落盘
#    4. 原子替换：先写临时文件再 mv 覆盖，避免半截文件
#    5. 可选同步更新 archlinuxcn 镜像列表（--cn）
#
#  用法：upmirror [选项]（见 upmirror --help）
# ==============================================================================

set -uo pipefail

